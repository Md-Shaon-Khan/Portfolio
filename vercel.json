{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "backend/app/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/googleb27af7f5cfae0aa1.html",
      "dest": "frontend/googleb27af7f5cfae0aa1.html"
    },
    {
      "src": "^/_/backend/(.*)",
      "dest": "backend/app/main.py"
    },
    {
      "src": "^/(.*)",
      "dest": "frontend/$1"
    }
  ]
}